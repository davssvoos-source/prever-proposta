<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ══ A ETIQUETA NFC ABRE O APP (R266) ═══════════════════════════
                 A etiqueta guarda um ENDEREÇO (…/viatura/<codigo>). Sem este
                 filtro, encostar o celular abre o NAVEGADOR, não o Prever.

                 Falta UMA coisa: o host. O Davi decidiu em 13/09 que o sistema
                 NÃO fica na Lovable (a empresa tem DDNS, host e domínio); qual
                 domínio o APK passa a apontar é a resposta que vem do Nicholas
                 (T.I.). Assim que ela existir, troque prever.exemplo.com.br
                 pelos dois lugares abaixo, tire os comentários, e publique o
                 assetlinks.json em https://<dominio>/.well-known/assetlinks.json
                 (é o que o autoVerify confere; sem ele o Android pergunta
                 "abrir com" em vez de abrir direto).

                 ATENÇÃO, e isto a revisão mediu: o servidor Windows serve HTTP
                 puro (deploy/windows/instalar.ps1). O Android bloqueia cleartext
                 por padrão, então App Link em http:// não funciona — o domínio
                 precisa de TLS.

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="prever.exemplo.com.br" android:pathPrefix="/viatura" />
            </intent-filter>
            ══════════════════════════════════════════════════════════════ -->

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- R273/R274: a chegada por localização. Sem estas duas, o
         `navigator.geolocation` do WebView é recusado em silêncio e a faixa da
         Início nunca sugere encerrar a viagem. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- R266: a etiqueta do carro. `required="false"` de propósito: celular
         sem NFC continua instalando o app e usa a lista em /viatura. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
</manifest>
