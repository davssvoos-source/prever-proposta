# Copie para .env e preencha. NUNCA versione o .env.
#
# Públicas (vão para o bundle do cliente — podem aparecer no navegador):
SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# SEGREDOS — só no servidor (painel de env da hospedagem), JAMAIS com VITE_:
# prefixo VITE_ publica a variável no bundle. Estas duas dariam acesso total
# ao banco e à conta da Anthropic.
# SUPABASE_SERVICE_ROLE_KEY=""
# ANTHROPIC_API_KEY=""
